ENVIRONMENT=development            # set to "production" to hide /docs
DATABASE_URL=mysql+pymysql://ict_du_user:mypassword123@127.0.0.1:3306/ict_du_ai
SECRET_KEY=a7998d9777222798507621490787b929f40976d19f46ff3bd1f1e9cf97d59897
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# MySQL container (docker-compose)
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=ictdu
MYSQL_USER=ictdu
MYSQL_PASSWORD=change_me

# === MUST BE SET: real campus coordinates (Systems Plus College Foundation, Balibago, Angeles City) ===
# Get them from Google Maps: right-click the campus centre -> click the coordinates to copy.
CAMPUS_LATITUDE=15.15821
CAMPUS_LONGITUDE=120.59379
ALLOWED_RADIUS_METERS=100
MAX_GPS_ACCURACY_METERS=50

TIMEZONE=Asia/Manila
ATTENDANCE_START=08:00
LATE_AFTER=08:15

FACE_MATCH_THRESHOLD=0.45
# Passive anti-spoof (MiniFASNet ONNX). Leave REQUIRE=true in production.
ANTISPOOF_REQUIRE_PASSIVE=true
ANTISPOOF_MODEL_PATHS=/app/models/2.7_80x80_MiniFASNetV2.onnx:2.7,/app/models/4_0_80x80_MiniFASNetV1SE.onnx:4.0
ANTISPOOF_THRESHOLD=0.7

DRIVE_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/service-account.json
GOOGLE_DRIVE_FOLDER_ID=
